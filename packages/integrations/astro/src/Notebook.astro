---
import type { NotebookOptions } from "@zikojs/notebook";

type Props = NotebookOptions;

const props: Props = Astro.props;

const serializedConfig = JSON.stringify(props)
---

<div
  data-engine = 'zikojs'
  data-notebook-wrapper
  data-notebook-config={serializedConfig}
></div>

<script>
  import { Notebook } from "@zikojs/notebook/no-css";

  document.querySelectorAll<HTMLElement>("[data-notebook-wrapper]").forEach((element) => {
    const config = element.dataset.notebookConfig
      ? JSON.parse(element.dataset.notebookConfig)
      : {};

    Notebook(config).mount(element);
  });
</script>

<style is:global>
  @import "@zikojs/notebook/style";
</style>
